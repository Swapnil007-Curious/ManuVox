{
  "name": "manuvox",
  "private": true,
  "version": "1.0.0",
  "description": "Offline browser demo: isolated sign recognition from webcam landmarks, entirely on device.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "node scripts/check-contrast.mjs",
    "vocabulary": "node scripts/export-vocabulary.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
