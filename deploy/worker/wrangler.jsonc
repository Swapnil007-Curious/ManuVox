// Cloudflare Worker: the sentence translator of the ManuVox web app (web/). The Worker keeps its
// original name, edge-vision-translate, so its URL is unchanged.
// Deploy: npx wrangler login; npx wrangler secret put LLM_API_KEY; npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-vision-translate",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": false
  },
  "vars": {
    // The OpenAI-compatible endpoint and model (the API key is a secret, never a var).
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "llama-3.1-8b-instant",
    // Origins allowed to call the Worker (http://localhost:* is always allowed for development).
    "ALLOWED_ORIGINS": "https://swapnil007-curious.github.io",
    "MAX_OUTPUT_TOKENS": "120",
    "LIMIT_PER_10MIN": "30",
    "LIMIT_PER_DAY": "300",
    "GLOBAL_PER_DAY": "3000"
  },
  // Rate limits live in one Durable Object per client address plus one global object (SQLite
  // backend: the only kind on the Workers Free plan). See src/limits.ts for why.
  "durable_objects": {
    "bindings": [
      {
        "name": "LIMITS",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RateLimiter"
      ]
    }
  ]
}