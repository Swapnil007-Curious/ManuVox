# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Virtual environments (.venv-live: MediaPipe Holistic and OpenCV for the live-gap tools)
.venv/
.venv-live/
venv/

# Data and generated outputs
# Anchored to the repo root: a bare "data/" would also ignore src/edgevision/data/.
/data/
# Kaggle training outputs and the recorded webcam clips (personal video): local inputs only.
/artifacts/
/test_clips/
/test_clips_v2/
results/live_gap/*.log
results/live_gap_v2/*.log
results/live_gap_v3/*.log
# Teach Dex evaluation: raw logits and embeddings of the personal clips stay local; the per-clip
# outcomes (run*.outcomes.json) and the summary are committed.
results/teach_dex*/web/*.raw.json
results/teach_dex*/web/*.log
# LaTeX build logs (paper/main.pdf and paper/ieee/main_ieee.pdf themselves are committed)
paper/*.log
paper/*.blg
paper/*.aux
paper/ieee/*.log
paper/ieee/*.blg
paper/ieee/*.aux
results/**/artifacts
# Quantised models; their quant_report.json files and the result CSVs stay tracked.
results/quant/**/*.onnx
results_bundle.zip
*.pt
*.onnx
*.npz
*.parquet

# Tool caches
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Web demo: dependencies, fetched third-party assets (npm run fetch-assets) and test output.
web/node_modules/
web/dist/
web/dist-shots/
web/public/mediapipe/
web/test-results/
web/playwright-report/
# The exported browser model is committed while it stays under 10 MB.
!web/public/model/model.onnx
# The v3 model (trained on ASL Citizen, research licence): local only, never in git or the public
# build (web/model-variant.ts, docs/DATA_LICENSES.md).
web/models/
